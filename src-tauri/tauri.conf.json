{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeTerm",
  "version": "../package.json",
  "identifier": "com.edgeterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EdgeTerm",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-7d43fe53e45d6e1f55bf4a0dae01916b88b0fe9882f7f96abe47e8962d349eae'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Lightweight terminal, SSH, FTP and serial client built with Rust (installer under 5 MB)",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "rpm": {
        "release": "1",
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)",
          "libudev.so.1()(64bit)"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRjNBMkUwMEU0NjE3QzEKUldUQkYwWU80S0x6eXNLWEx2d2VmZzJ3NVRiL1huRWN6ZWI3SDdXbFBBYlIrejhyaHc0Z1UyS1UK",
      "endpoints": [
        "https://github.com/o-i-i-o/EdgeTerm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
